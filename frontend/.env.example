# Where the Flask server calls the FastAPI backend (server-to-server)
API_URL=http://127.0.0.1:8000
# Public URL of the API as the BROWSER sees it (used for receipt links). Defaults to API_URL.
# API_PUBLIC_URL=https://expense-tracker-api.onrender.com
# Signs the session cookie. Required when ENVIRONMENT=production.
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
PORT=5000
