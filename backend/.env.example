# Copy to .env for local development. Real environment variables always win over this file.
ENVIRONMENT=development
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite for local work. For Postgres use e.g. postgresql+asyncpg://user:pass@host/dbname
# (plain postgres:// and postgresql:// URLs are converted automatically)
DATABASE_URL=sqlite+aiosqlite:///./data/expenses.db

# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CACHE_TTL_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
CRAWLER_RATE_LIMIT_PER_MINUTE=10
